# Database
POSTGRES_DB=caravan
POSTGRES_USER=caravan
POSTGRES_PASSWORD=caravan_secret
DB_HOST=db
DB_PORT=5432

# Django
SECRET_KEY=change-me-in-production-use-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,nginx,backend
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
FRONTEND_URL=http://localhost

# Admin bootstrap
CREATE_SUPERUSER=true
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@caravan.local
DJANGO_SUPERUSER_PASSWORD=admin12345

# JWT (minutes)
JWT_ACCESS_LIFETIME=60
JWT_REFRESH_LIFETIME=10080

# Email (SMTP) — для восстановления пароля и уведомлений
# Без EMAIL_HOST письма выводятся в консоль backend (docker compose logs backend)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Караван <noreply@caravan.local>

# Уведомления о заказах
NOTIFY_EMAIL=True
NOTIFY_SMS=False

# SMS (опционально) — console | http
SMS_ENABLED=False
SMS_PROVIDER=console
SMS_API_URL=
SMS_API_TOKEN=
SMS_SENDER=Caravan
